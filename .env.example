# ============================================================================
# DATABASE CONFIGURATION
DATABASE_URL=postgresql://usuario:contraseña@localhost:5432/stonefixer_dev

# ============================================================================
# KPI DATABASE (Solo lectura para reportes)
KPI_DATABASE_URL=postgresql://usuario:contraseña@localhost:5432/kpi_db

# ============================================================================
# SECURITY
# Genera con: openssl rand -hex 32
SECRET_KEY=your-secret-key-here-change-this-in-production

# JWT Settings
ACCESS_TOKEN_EXPIRE_MINUTES=30
ALGORITHM=HS256

# ============================================================================
# APPLICATION
APP_NAME=StoneFixer
ENVIRONMENT=development  # development | staging | production
DEBUG=true

# ============================================================================
# CORS (Allowed Origins)
# En desarrollo: http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ============================================================================
# Auth endpoints
LOGIN_RATE_LIMIT=5/minute
REGISTER_RATE_LIMIT=3/hour

# API General (default para todos los endpoints)
API_RATE_LIMIT=100/minute

# Endpoints de lectura (GET)
READ_RATE_LIMIT=200/minute

# Endpoints de escritura (POST/PUT/DELETE)
WRITE_RATE_LIMIT=50/minute

# Endpoints críticos (crear/eliminar activos, asignaciones)
CRITICAL_WRITE_RATE_LIMIT=20/minute

# Búsquedas y filtros
SEARCH_RATE_LIMIT=100/minute


# ============================================================================
# EMAIL (Para notificaciones)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu-email@gmail.com
SMTP_PASSWORD=tu-app-password
EMAIL_FROM=noreply@stonefixer.com

# ============================================================================
# LOGGING
LOG_LEVEL=INFO  # DEBUG | INFO | WARNING | ERROR