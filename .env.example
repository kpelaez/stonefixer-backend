# ============================================================================
# DATABASE CONFIGURATION
DATABASE_URL=postgresql://usuario:contraseña@localhost:5432/stonefixer_dev

# ============================================================================
# KPI DATABASE (Solo lectura para reportes)
KPI_DATABASE_URL=postgresql://usuario:contraseña@localhost:5432/kpi_db

# ============================================================================
# SECURITY
# Genera con: openssl rand -hex 32
SECRET_KEY=your-secret-key-here-change-this-in-production

# JWT Settings
ACCESS_TOKEN_EXPIRE_MINUTES=30
ALGORITHM=HS256

# ============================================================================
# APPLICATION
APP_NAME=StoneFixer
ENVIRONMENT=development  # development | staging | production
DEBUG=true

# ============================================================================
# CORS (Allowed Origins)
# En desarrollo: http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ============================================================================
# Auth endpoints
LOGIN_RATE_LIMIT=5/minute
REGISTER_RATE_LIMIT=3/hour

# API General (default para todos los endpoints)
API_RATE_LIMIT=100/minute

# Endpoints de lectura (GET)
READ_RATE_LIMIT=200/minute

# Endpoints de escritura (POST/PUT/DELETE)
WRITE_RATE_LIMIT=50/minute

# Endpoints críticos (crear/eliminar activos, asignaciones)
CRITICAL_WRITE_RATE_LIMIT=20/minute

# Búsquedas y filtros
SEARCH_RATE_LIMIT=100/minute


# ============================================================================
# SWAGGER DOCS (protegido con Basic Auth)
SWAGGER_USERNAME=admin
SWAGGER_PASSWORD=<generá con: openssl rand -base64 16>

# ============================================================================
# DNI ENCRYPTION
# Genera con: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DNI_ENCRYPTION_KEY=your-fernet-key-here

# ============================================================================
# LOGGING
LOG_LEVEL=INFO  # DEBUG | INFO | WARNING | ERROR

# ============================================================================
# APPLICATION URLs
APP_BASE_URL=https://tu-dominio.com

# ============================================================================
# HUMAND INTEGRATION
HUMAND_API_URL=https://api-prod.humand.co/public/api/v1
HUMAND_API_KEY=Basic your-api-key-here
HUMAND_FOLDER_ID=123456

# ============================================================================
# CLOUDFLARE
CLOUDFLARE_TUNNEL_TOKEN=your-tunnel-token-here

# ============================================================================
# RATE LIMITING
RATE_LIMIT_ENABLED=True

# ============================================================================
# JWT REFRESH
REFRESH_TOKEN_EXPIRE_DAYS=7

# ============================================================================
# OMNI CREDENTIALS
OMNI_USER=tu_usuario
OMNI_PASSWORD=tu_password
FINNEGANS_URL=https://api.finneg.com/api
CLIENT_KEY=
SECRET_KEY=